{
  "name": "services-tekraze",
  "version": "1.0.0",
  "private": true,
  "description": "services.tekraze \u2014 the Tekraze services site, presented as a streaming service.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepare-content": "node scripts/build-manifests.mjs",
    "media": "node scripts/process-media.mjs && node scripts/build-manifests.mjs",
    "webapp:add": "node scripts/add-webapp.mjs",
    "predev": "npm run prepare-content",
    "dev": "next dev",
    "prebuild": "npm run prepare-content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run prepare-content && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=moderate",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "pretest": "npm run prepare-content"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "framer-motion": "14.14.0",
    "gsap": "3.15.1",
    "lenis": "1.3.29",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "20.19.25",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.9",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
