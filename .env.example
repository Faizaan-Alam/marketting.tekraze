# ─────────────────────────────────────────────────────────────────────────────
# services.tekraze — environment variables. Copy to .env.local (never commit it).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for the Origin check on the enquiry form, canonical URLs).
SITE_URL=https://services.tekraze.com
# Extra origins allowed to submit the form, comma separated (e.g. a staging domain).
ALLOWED_ORIGINS=

# Secret for signing CSRF tokens and hashing IPs in logs. 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Header your reverse proxy sets to the REAL client IP (it must overwrite, not append).
# Nginx config in deploy/ sets X-Real-IP; Cloudflare sets CF-Connecting-IP.
CLIENT_IP_HEADER=x-real-ip

# ── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────────
# turnstile | none   ("none" is for local testing only — never in production)
CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email delivery ───────────────────────────────────────────────────────────
# smtp = send each enquiry by email;  log = only log a redacted line (local testing)
ENQUIRY_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The From address must be one your SMTP provider allows you to send from.
MAIL_FROM="Tekraze Services <no-reply@tekraze.com>"
MAIL_TO=

# ── Abuse limits (defaults shown) ────────────────────────────────────────────
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_GLOBAL_PER_HOUR=120
MIN_FILL_SECONDS=3

# ── Optional privacy-friendly analytics (off when empty) ─────────────────────
# Cookie-less script origin, e.g. https://plausible.io, plus your site domain.
NEXT_PUBLIC_ANALYTICS_ORIGIN=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
